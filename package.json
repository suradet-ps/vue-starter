{
  "name": "vue-starter",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "audit": "audit-ci --high",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "audit-ci": "^7.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "eslint-plugin-perfectionist": "5.x",
      "fast-uri": ">=3.1.6",
      "js-cookie": ">=3.0.7",
      "js-yaml": ">=4.3.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "eslint --fix"
    ]
  }
}
